---
import "../styles/global.css";
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const PAGE_TITLE = "ANNEX — Hidden Influence on a Public Map | Dipper Digital";
const PAGE_DESCRIPTION = "Play the ANNEX prototype, a strategy game about hidden influence on a public map.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={PAGE_TITLE} description={PAGE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="annex-page">
			<div class="annex-heading">
				<a href="/" class="back-link">← Dipper Digital</a>
				<h1>ANNEX</h1>
				<p>Hidden Influence on a Public Map</p>
			</div>
			<div class="game-frame-wrap">
				<iframe
					title="ANNEX prototype game"
					src="/annex-game/index.html"
					loading="eager"
					allow="fullscreen"
				></iframe>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.annex-page {
		width: min(1500px, calc(100% - 2em));
		max-width: none;
		padding: 2em 1em 3em;
	}
	.annex-heading {
		text-align: center;
		margin-bottom: 1.5em;
	}
	.back-link {
		display: inline-block;
		font-size: 0.85rem;
		text-decoration: none;
		margin-bottom: 1em;
	}
	.annex-heading h1 {
		margin-bottom: 0.15em;
		letter-spacing: 0.1em;
	}
	.annex-heading p {
		margin: 0;
		color: rgb(var(--gray));
	}
	.game-frame-wrap {
		border: 1px solid var(--border-color);
		border-radius: 14px;
		overflow: hidden;
		background: #070b14;
		box-shadow: var(--box-shadow);
	}
	iframe {
		display: block;
		width: 100%;
		height: min(900px, 78vh);
		min-height: 680px;
		border: 0;
	}
	@media (max-width: 720px) {
		.annex-page {
			width: 100%;
			padding: 1em 0 2em;
		}
		.annex-heading {
			padding: 0 1em;
		}
		.game-frame-wrap {
			border-radius: 0;
			border-left: 0;
			border-right: 0;
		}
		iframe {
			height: 850px;
			min-height: 0;
		}
	}
</style>
